-- ระบบ Sidebar
local function addTab(name, page)
    createBtn(sidebar, name, UDim2.new(1, 0, 0, 40)).MouseButton1Click:Connect(function() 
        homePage.Visible=false; customPage.Visible=false; musicPage.Visible=false; page.Visible=true 
    end)
end
addTab("🏠 หน้าหลัก", homePage); addTab("🎵 ไอดีเพลง", customPage); addTab("🎧 รายการเพลง", musicPage)
